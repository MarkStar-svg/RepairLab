@model ProfileViewModel
@{ ViewData["Title"] = "Профиль"; }
<partial name="_CabinetNav" />
<form asp-action="Profile" method="post" class="card form narrow">
    <h1>Профиль</h1>
    <p class="muted">Дата регистрации: @Model.CreatedAt.ToString("dd.MM.yyyy")</p>
    <div class="field"><label asp-for="FullName"></label><input asp-for="FullName" /><span asp-validation-for="FullName" class="err"></span></div>
    <div class="field"><label asp-for="Email"></label><input asp-for="Email" /><span asp-validation-for="Email" class="err"></span></div>
    <button class="btn">Сохранить</button>
</form>
