@model ChangePasswordViewModel
@{ ViewData["Title"] = "Смена пароля"; }
<partial name="_CabinetNav" />
<form asp-action="ChangePassword" method="post" class="card form narrow">
    <h1>Смена пароля</h1>
    <div class="field"><label asp-for="OldPassword"></label><input asp-for="OldPassword" /><span asp-validation-for="OldPassword" class="err"></span></div>
    <div class="field"><label asp-for="NewPassword"></label><input asp-for="NewPassword" /><span asp-validation-for="NewPassword" class="err"></span></div>
    <div class="field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" /><span asp-validation-for="ConfirmPassword" class="err"></span></div>
    <button class="btn">Изменить пароль</button>
</form>
